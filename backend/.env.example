# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string_here

# JSON Web Token secret for authentication
JWT_SECRET=your_jwt_secret_here

# Google Gemini API key (embeddings)
GEMINI_API_KEY1=your_gemini_api_key_here
GEMINI_API_KEY2=your_gemini_api_key_here
GEMINI_API_KEY3=your_gemini_api_key_here


# Groq API key (LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Backend application URL
BACKEND_URL=http://localhost:5000

# Frontend application URL
FRONTEND_URL=http://localhost:5173

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Brevo API key (transactional email sending via HTTPS REST API)
BREVO_API_KEY=your_brevo_api_key_here

# Sender address/name for transactional emails
EMAIL_FROM_ADDRESS=your_sender_email@example.com
EMAIL_FROM_NAME=DocTalk

# Stripe secret API key
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Price ID (subscription/product)
STRIPE_PRICE_ID=your_stripe_price_id_here

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

BREVO_API_KEY = your_brevo_api_key_here

EMAIL_FROM_ADDRESS=your_verified_gmail@gmail.com
EMAIL_FROM_NAME=your_email_display_name_here